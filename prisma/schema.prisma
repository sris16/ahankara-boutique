generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // directUrl = env("DIRECT_URL")
}

// Minimal model for V1 foundation testing
model SystemHealth {
  id        String   @id @default(cuid())
  status    String   @default("ok")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_health")
}

// Simple User model for V1 infrastructure validation
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
