# ==========================================
# AHANKARA STUDIOS — ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# DATABASE (Required for all environments)
# ------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/db_name"

# ------------------------------------------
# APPLICATION
# ------------------------------------------
NODE_ENV="development" # Set to 'production' for live deployment

# ------------------------------------------
# BETTER AUTH (Required for Authentication)
# ------------------------------------------
# In production, BETTER_AUTH_SECRET must be set and min 16 chars.
BETTER_AUTH_SECRET="super_secret_key_32bytes"
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------
# RESEND — EMAIL / OTP (Required for Authentication / Email in Prod)
# ------------------------------------------
# In production, RESEND_API_KEY must be set to send real emails.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Ahankara Studios <onboarding@resend.dev>"

# ------------------------------------------
# CLOUDINARY — PRODUCT IMAGES (Required for Image Storage in Prod)
# ------------------------------------------
# In production, these must be set to upload/delete images.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------
# RAZORPAY — PAYMENTS (Required for Checkout in Prod)
# ------------------------------------------
# In production, these must be actual live or test keys.
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------
# SHIPROCKET — SHIPPING (Required for Delivery Check/Rates in Prod)
# ------------------------------------------
# In production, these must be actual credentials.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_WEBHOOK_SECRET=""
